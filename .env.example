# Dominio público (SEO: canonical, sitemap y robots.txt)
VITE_DOMAIN=TU_DOMINIO

# Enlaces y mantenimiento
VITE_GITHUB=URL_DE_TU_REPOSITORIO
VITE_MAINTENANCE_MODE=0

# Backend NestJS (sesión, historial, ajustes y ChófIA)
VITE_API_URL=<URL_DESTINO>
VITE_URL_ORIGIN=<URL_ORIGEN>

# Medición de visitas (opcional). Dejar vacío para desactivar.
VITE_GA_ID=<GA_ID>


# VERIFICACION
VITE_CODE_LENGTH=<CODE_LENGTH>

# ZONA
VITE_ZONE=<ZONA>

# Patrocinador (opcional)
VITE_S_OLAVARRIA_SERVICIOS=URL_DEL_PATROCINADOR
VITE_S_OLAVARRIA_SERVICIOS_URL_IMAGE=URL_DE_LA_IMAGEN
VITE_S_OLAVARRIA_SERVICIOS_URL_LOGO=URL_DEL_LOGO

# Firebase Web (solo autenticación)
VITE_API_KEY=TU_API_KEY
VITE_PROJECT_ID=TU_PROJECT_ID
VITE_SENDER_ID=TU_SENDER_ID
VITE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
VITE_STORAGE_BUCKET=TU_PROYECTO.appspot.com
VITE_APP_ID=TU_APP_ID
